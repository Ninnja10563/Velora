# No key is required for the clearly labeled demonstration catalog.
# Keep credentials in ignored local environment files or the host's secret manager.
# Never prefix server credentials with NEXT_PUBLIC_.

# Optional structured AI intent service. Product facts still come only from provider data.
AI_INTENT_ENDPOINT=
AI_INTENT_API_KEY=

# PostgreSQL over the Supabase HTTPS REST API. Apply database/schema.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Enable ONLY behind Sites' trusted identity-injecting dispatch.
# Never enable on a publicly reachable origin accepting caller-controlled identity headers.
TRUST_SITES_IDENTITY=false

# Comma-separated exact Sites user IDs. Empty list denies every administrator.
# Starter development identity local_seedy is always denied admin access.
ADMIN_USER_IDS=

# Keep false until a verified affiliate network ingestion service is implemented.
AFFILIATE_CONVERSIONS_ENABLED=false

# Approved full affiliate URLs keyed by offer ID, for example an empty object.
AFFILIATE_LINKS_JSON={}
# Extra exact tracking hosts in addition to each offer's ordinary retailer host.
AFFILIATE_ALLOWED_HOSTS=

# Only when the edge sanitizes X-Forwarded-For. Otherwise leave disabled.
TRUST_PROXY=false
