# Copy to .env.local for native Next development. Never commit real credentials.
# All keys below are server-only; never prefix them with NEXT_PUBLIC_.
APP_URL=http://127.0.0.1:3000

# Product retrieval: demo | feed | ebay. Selected live providers fail closed;
# they never silently substitute demonstration products.
PRODUCT_PROVIDER=demo
PRODUCT_FEED_URL=
PRODUCT_FEED_TOKEN=
# Exact permitted hosts for feed product, offer and attribute-source URLs.
PRODUCT_RETAILER_HOSTS=
PRODUCT_FEED_CACHE_SECONDS=300
PRODUCT_LIVE_MAX_AGE_SECONDS=300
# Explicit development-only opt-in for a loopback fixture/feed endpoint.
PRODUCT_FEED_ALLOW_LOCALHOST=false

# eBay Browse API. Production access/affiliate approval is your responsibility.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENVIRONMENT=production
# Leave blank to choose US/AU/GB/DE/CA from the shopper’s selected currency.
EBAY_MARKETPLACE_ID=
# Optional initial discovery keywords; blank defaults to wireless headphones.
EBAY_DISCOVERY_QUERY=
# Optional approved eBay Partner Network campaign ID (never invent one).
EBAY_CAMPAIGN_ID=

# Request interpretation: local | openai | http.
# OpenAI proposes a validated shopping tool call; retailer data supplies facts.
AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=
AI_INTENT_ENDPOINT=
AI_INTENT_API_KEY=

# PostgreSQL + Supabase Auth. Apply both checked-in Supabase migrations.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may use ANON_KEY instead of PUBLISHABLE_KEY.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Local Supabase requires Docker/CLI, or use a real configured Supabase project.
ALLOW_LOCAL_SUPABASE=false

# Enable only behind Sites' trusted identity-injecting dispatch, never on an
# ordinary public Next origin accepting caller-controlled identity headers.
TRUST_SITES_IDENTITY=false
# Exact user IDs, e.g. supabase:<uuid>; empty denies administrator access.
ADMIN_USER_IDS=

# At least 32 random characters. An external scheduler must POST the protected
# /api/cron/price-alerts endpoint. Merely setting this does not run a schedule.
CRON_SECRET=
PRICE_ALERT_MAX_AGE_SECONDS=3600

# Approved full affiliate URLs keyed by offer ID; ordinary URLs stay separate.
AFFILIATE_LINKS_JSON={}
AFFILIATE_ALLOWED_HOSTS=
# No network conversion ingestion is implemented. Do not turn this on solely
# because click tracking or an affiliate campaign is configured.
AFFILIATE_CONVERSIONS_ENABLED=false

# Enable only where the named header is overwritten by a trusted proxy.
TRUST_PROXY=false
TRUST_CLOUDFLARE=false
